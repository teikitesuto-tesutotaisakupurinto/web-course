rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get("disabled", false) != true;
    }

    function isTeacher() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "teacher";
    }

    function userClassName() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        ? get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.get("className", "")
        : "";
    }


    // =========================
    // ユーザー
    // =========================

    match /users/{userId} {

      allow read:
        if request.auth != null
        && (
          request.auth.uid == userId
          || isTeacher()
        );

      allow create, update, delete:
        if isTeacher();
    }


    // =========================
    // 講座
    // =========================

    match /courses/{courseId} {

      allow read:
        if signedIn()
        && (
          isTeacher()
          || resource.data.published == true
        );

      allow create, update, delete:
        if isTeacher();
    }


    // =========================
    // 動画
    // =========================

    match /courses/{courseId}/lessons/{lessonId} {

      allow read:
        if signedIn()
        && (
          isTeacher()
          ||
          (
            get(
              /databases/$(database)/documents/courses/$(courseId)
            ).data.published == true
            &&
            (
              (
                get(
                  /databases/$(database)/documents/courses/$(courseId)
                ).data.get("targetClasses", []).size() == 0
                &&
                get(
                  /databases/$(database)/documents/courses/$(courseId)
                ).data.get("targetStudents", []).size() == 0
              )
              ||
              get(
                /databases/$(database)/documents/courses/$(courseId)
              ).data.get("targetClasses", []).hasAny([userClassName()])
              ||
              get(
                /databases/$(database)/documents/courses/$(courseId)
              ).data.get("targetStudents", []).hasAny([request.auth.uid])
            )
            &&
            resource.data.published == true
          )
        );

      allow create, update, delete:
        if isTeacher();
    }


    // =========================
    // 受講進捗
    // =========================

    match /progress/{progressId} {

      allow read:
        if isTeacher()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create, update:
        if isTeacher()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      allow delete:
        if isTeacher();
    }


    // =========================
    // サイト設定
    // =========================

    match /settings/{settingId} {

      allow read:
        if settingId == "site" || signedIn();

      allow create, update, delete:
        if isTeacher();
    }

  }

}
